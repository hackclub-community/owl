{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
